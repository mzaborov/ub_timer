# Копируйте в secrets.env и заполните значения. secrets.env в .gitignore.

FTP_HOST=ваш-хост
FTP_USER=логин
FTP_PASSWORD=пароль
FTP_REMOTE_DIR=timer.zaborov.ru/www
FTP_PORTAL_REMOTE_DIR=ciocdo-org-skills.zaborov.ru/www

# Пароль режима орга на портале (не в git).
# PORTAL_ORG_PASSWORD=

# SSH Masterhost (cron бэкапа MySQL). Тот же аккаунт, что FTP-площадка.
# SSH_HOST=u10190.ssh.masterhost.ru
# SSH_USER=u10190
# SSH_PORT=22
# SSH_PASSWORD=

# Заливка домена: python scripts/load_domain_mysql.py (upsert, без DROP). Опасный снос: --fresh
# MySQL Masterhost (портал). Пароль только в secrets.env, не сюда.
# MYSQL_HOST=u10190.mysql.masterhost.ru
# MYSQL_DATABASE=u10190_ubtimer
# MYSQL_USER=u10190
# MYSQL_PASSWORD=

# GAS_SCRIPT_ID — Apps Script → Настройки проекта → идентификатор
# GAS_OAUTH_CREDENTIALS=scripts/google-apps-script/gas-oauth-client.json
# GAS_WEBAPP_DEPLOYMENT_ID — id versioned Web App (…/macros/s/<id>/exec), чтобы deploy_gas.py не ломал entryPoints
# LIVE_PROTOCOL_KEY — Script Property + клиент (по умолчанию ub-live-2026; не коммитить боевой ключ)
# OpenRouter — автогенерация банка ситуаций (копировать QWEN_API_KEY в Apps Script → Script Properties).
# Те же ключи load_domain_mysql.py пишет в db.inc.php на сервере (портал, кнопка «Сгенерировать разметку»).
# LLM_PROVIDER=openrouter
# QWEN_API_KEY=sk-or-v1-...
# QWEN_MODEL=qwen/qwen-plus

# Исключения из выкладки (опционально; если не заданы — используются встроенные списки).
# Скрипты выкладки лежат в папке scripts/ и не заливаются на прод (scripts в DEPLOY_EXCLUDE_ROOTS).
# DEPLOY_EXCLUDE_ROOTS — папки в корне репо (через запятую).
# DEPLOY_EXCLUDE_FILES — отдельные файлы в корне (через запятую).
# DEPLOY_EXCLUDE_ROOTS=.git,secrets.env,scripts,.gitignore,.cursor,node_modules,History.log,.vscode,git_hint.txt,Таблицы для онлайнов,docs,ciocdo
# DEPLOY_EXCLUDE_FILES=secrets.env,secrets.env.example,.gitignore,History.log,git_hint.txt,Макет часов.vsdx
