# Копируйте в secrets.env и заполните значения. secrets.env в .gitignore.

FTP_HOST=ваш-хост
FTP_USER=логин
FTP_PASSWORD=пароль
FTP_REMOTE_DIR=timer.zaborov.ru/www

# OpenRouter — автогенерация банка ситуаций (копировать QWEN_API_KEY в Apps Script → Script Properties)
# LLM_PROVIDER=openrouter
# QWEN_API_KEY=sk-or-v1-...
# QWEN_MODEL=qwen/qwen-plus

# Исключения из выкладки (опционально; если не заданы — используются встроенные списки).
# Скрипты выкладки лежат в папке scripts/ и не заливаются на прод (scripts в DEPLOY_EXCLUDE_ROOTS).
# DEPLOY_EXCLUDE_ROOTS — папки в корне репо (через запятую).
# DEPLOY_EXCLUDE_FILES — отдельные файлы в корне (через запятую).
# DEPLOY_EXCLUDE_ROOTS=.git,secrets.env,scripts,.gitignore,.cursor,node_modules,History.log,.vscode,git_hint.txt,Таблицы для онлайнов,docs
# DEPLOY_EXCLUDE_FILES=secrets.env,secrets.env.example,.gitignore,History.log,git_hint.txt,Макет часов.vsdx
