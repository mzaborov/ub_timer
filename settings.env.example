# Не-секретный конфиг ub-timer. Копировать в settings.env (в .gitignore).
# Секреты (FTP_USER, FTP_PASSWORD, QWEN_API_KEY, MYSQL_PASSWORD, PORTAL_ORG_PASSWORD,
# SSH_PASSWORD, BIPIUM_LOGIN, BIPIUM_PASSWORD) в файле НЕ хранятся — их инжектит kvault:
#   kvault run -- python scripts/<script>.py
#   kvault run -- pwsh scripts/deploy.ps1

FTP_HOST=ftp.example.com
FTP_REMOTE_DIR=timer.zaborov.ru/www

SSH_HOST=u10190.ssh.masterhost.ru
SSH_USER=u10190
SSH_PORT=22

MYSQL_HOST=localhost
MYSQL_DATABASE=u10190_ubtimer
MYSQL_USER=u10190

LLM_PROVIDER=alibaba
QWEN_MODEL=qwen-plus-latest
# Кастомный OpenAI-compatible baseURL (Alibaba Model Studio workspace). Пусто → провайдер по умолчанию.
LLM_BASE_URL=https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
GAS_SCRIPT_ID=
GAS_WEBAPP_DEPLOYMENT_ID=
PORTAL_DEFAULT_ZOOM=
BIPIUM_URL=https://ciocdo.bpium.ru
